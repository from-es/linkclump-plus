{
  "name": "linkclump-plus",
  "description": "Lets you open, copy or bookmark multiple links at the same time. Cross-browser extension supporting both Chrome and Firefox.",
  "version": "2.17.3",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/from-es/linkclump-plus.git"
  },
  "bugs": {
    "url": "https://github.com/from-es/linkclump-plus/issues"
  },
  "homepage": "https://github.com/from-es/linkclump-plus",
  "type": "module",
  "scripts": {
    "dev:chrome": "wxt --browser chrome --mv3",
    "dev:firefox": "wxt --browser firefox --mv3",
    "build:chrome:prod": "wxt build --browser chrome --mv3",
    "build:chrome:prod:sourcemap": "wxt build --browser chrome --mv3 --mode sourcemap",
    "build:firefox:prod": "wxt build --browser firefox --mv3",
    "build:firefox:prod:sourcemap": "wxt build --browser firefox --mv3 --mode sourcemap",
    "zip:chrome": "wxt zip --browser chrome --mv3",
    "zip:firefox": "wxt zip --browser firefox --mv3",
    "typecheck": "tsc --noEmit",
    "eslint": "eslint --format stylish src",
    "vitest": "vitest",
    "vitest:run": "vitest run",
    "vitest:ui": "vitest --ui",
    "vitest:coverage": "vitest run --coverage",
    "vitest:smoke": "vitest run --config vitest.smoke.config.ts",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/jquery": "^4.0.1",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.5",
    "wxt": "^0.21.4"
  },
  "dependencies": {
    "dayjs": "^1.11.23",
    "jquery": "^4.0.0"
  }
}
